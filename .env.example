# Copy this file to .env and fill in your real values. Never commit the real .env file.

# Supabase connection string (Project Settings -> Database -> Connection string -> URI)
# Use the pooler connection string (port 6543) for the running app.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres

# A long random string used to sign login sessions. Generate a new one for production —
# never reuse the dev placeholder.
JWT_SECRET=change-this-to-a-long-random-string

# Groq API key (console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Resend (resend.com) — used to send password reset emails.
# RESEND_FROM_EMAIL must be a domain you've verified in Resend, or leave it
# as the Resend sandbox address below while testing.
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Orivon <onboarding@resend.dev>

# The public URL of your deployed app (used to build the link inside reset
# emails). Leave unset locally — it'll fall back to the request's own host.
APP_URL=https://your-app.onrender.com

PORT=3000

# Paystack (paystack.com) — payments. Use the TEST secret key (sk_test_...) until
# you're ready to go live, then swap in the live key (sk_live_...). Never commit it.
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Optional: AI usage limits per account (defaults shown)
# AI_REQUESTS_PER_MINUTE=8
# AI_DAILY_TOKENS_FREE=60000
# AI_DAILY_TOKENS_PRO=300000
